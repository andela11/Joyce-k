# ==========================================
# JOYCE-K - VARIABLES D'ENVIRONNEMENT
# Architecture séparée : Backend (Render) + Frontend (Vercel)
# ==========================================

# ------------------------------------------
# 1. BACKEND SUR RENDER (Web Service Node.js)
# ------------------------------------------
# Clé API Google Gemini (Traitement IA Côté Serveur & Vision Sécurisée)
# Utilisée par Express backend (/server.ts) pour l'analyse anti-IA, suggestions, etc.
GEMINI_API_KEY=""

# Port d'écoute (injecté automatiquement par Render, défaut: 10000 ou 3000)
PORT=10000

# Environnement de production
NODE_ENV="production"

# URL du frontend hébergé sur Vercel (pour autoriser les requêtes CORS)
# Exemple: https://joyce-k.vercel.app
FRONTEND_URL="https://joyce-k.vercel.app"

# URL publique de l'application
APP_URL=""

# ------------------------------------------
# 2. FRONTEND SUR VERCEL (Application React Vite)
# ------------------------------------------
# URL du backend hébergé sur Render (doit commencer par VITE_ pour être accessible côté client)
# Exemple: https://joyce-k-backend.onrender.com
VITE_API_URL="https://joyce-k-backend.onrender.com"

# ------------------------------------------
# 3. CONFIGURATION CLIENT FIREBASE (VITE)
# (À renseigner dans les variables d'environnement de Vercel)
# ------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
